rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function isBatchMember(batchId) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/batches/$(batchId)).data.studentUids;
    }

    // ---------------- users ----------------
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // Admin creates the doc when adding a student; a signed-in user may
      // only ever edit their own doc, and never change their own role.
      allow create: if isAdmin();
      allow update: if isAdmin() ||
        (signedIn() && request.auth.uid == uid && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    // ---------------- batches ----------------
    match /batches/{batchId} {
      allow read: if isAdmin() || isBatchMember(batchId);
      allow write: if isAdmin();

      match /materials/{id} {
        allow read: if isAdmin() || isBatchMember(batchId);
        allow write: if isAdmin();
      }

      match /videos/{id} {
        allow read: if isAdmin() || isBatchMember(batchId);
        allow write: if isAdmin();
      }

      match /liveSessions/{id} {
        allow read: if isAdmin() || isBatchMember(batchId);
        allow write: if isAdmin();
      }

      match /tests/{testId} {
        allow read: if isAdmin() || isBatchMember(batchId);
        allow write: if isAdmin();

        match /results/{studentUid} {
          allow read: if isAdmin() || (signedIn() && request.auth.uid == studentUid);
          allow create, update: if isAdmin() || (signedIn() && request.auth.uid == studentUid);
          allow delete: if isAdmin();
        }
      }
    }
  }
}
